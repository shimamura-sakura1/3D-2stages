# Copy to .env. Keep real endpoints, account names, tokens, and machine paths out of Git.
HY3D_ENDPOINT=http://127.0.0.1:8080
HY3D_TIMEOUT_S=300
HY3D_API_TOKEN=

# Fill these before using configs/hy3d_ssh.yaml.
HY3D_SSH_HOST=
HY3D_SSH_PORT=22
HY3D_SSH_USER=
HY3D_SSH_IDENTITY_FILE=
HY3D_SSH_KNOWN_HOSTS_FILE=
HY3D_SSH_LOCAL_PORT=18080
HY3D_SSH_REMOTE_PORT=8080
HY3D_SSH_CONNECT_TIMEOUT_S=10

# Optional local batch Blender path; blank uses native discovery. Never share machine paths.
BLENDER_EXECUTABLE=
# Governance uses the process variable CONTRACT_GOVERN_HOME or --framework,
# otherwise a sibling contract-govern-skil checkout. It does not load credentials from this file.
