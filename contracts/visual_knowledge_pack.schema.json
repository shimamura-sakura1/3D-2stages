{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgePack",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "description",
    "domains",
    "item_ids",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "item_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "canonical",
        "deprecated"
      ]
    }
  },
  "additionalProperties": false
}
