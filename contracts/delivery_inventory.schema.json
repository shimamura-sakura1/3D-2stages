{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "project_id": {
      "$ref": "visual_common.schema.json#/$defs/id"
    },
    "scene_version": {
      "type": "integer",
      "minimum": 1
    },
    "pass_id": {
      "type": "string",
      "pattern": "^pass_[0-9]{2,}$"
    },
    "snapshot_sha256": {
      "$ref": "visual_common.schema.json#/$defs/sha256"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "visual_common.schema.json#/$defs/path"
          },
          "sha256": {
            "$ref": "visual_common.schema.json#/$defs/sha256"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "scene_version",
    "pass_id",
    "snapshot_sha256",
    "files"
  ],
  "additionalProperties": false
}
