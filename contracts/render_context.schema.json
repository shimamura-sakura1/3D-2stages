{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "project_id",
        "scene_version"
      ],
      "additionalProperties": false
    },
    "intent": {
      "type": "object",
      "properties": {
        "visual_brief_id": {
          "type": "string",
          "minLength": 1
        },
        "user_prompt": {
          "type": "string",
          "minLength": 1
        },
        "user_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "preserve": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "visual_brief_id",
        "user_prompt",
        "user_constraints",
        "preserve"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "scene_type": {
          "enum": [
            "hero_prop",
            "industrial_environment",
            "industrial_megastructure",
            "interior"
          ]
        },
        "primary_subject": {
          "type": "object",
          "properties": {
            "object_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "object_id"
          ],
          "additionalProperties": false
        },
        "bounds": {
          "type": "object",
          "properties": {
            "center": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "size": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "center",
            "size"
          ],
          "additionalProperties": false
        },
        "secondary_subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "object_id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "object_id"
            ],
            "additionalProperties": false
          }
        },
        "environment_summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scene_type",
        "primary_subject",
        "bounds",
        "secondary_subjects",
        "environment_summary"
      ],
      "additionalProperties": false
    },
    "style": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "composition",
              "camera",
              "lighting",
              "atmosphere",
              "material_readability",
              "style"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "previous": {
      "type": "object",
      "properties": {
        "direction": {
          "anyOf": [
            {
              "$ref": "render_direction.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "render": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "render_id": {
                  "type": "string",
                  "minLength": 1
                },
                "png_path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "render_id",
                "png_path"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "review": {
          "anyOf": [
            {
              "$ref": "render_review.schema.json"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "direction",
        "render",
        "review"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project",
    "intent",
    "scene",
    "style",
    "references",
    "previous"
  ],
  "additionalProperties": false
}
