{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "create_direction",
        "review_render",
        "refine_direction"
      ]
    },
    "inputs": {
      "type": "object",
      "properties": {
        "visual_brief": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "scene_context": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "style_context": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "knowledge_context": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "scene_state": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_render_direction": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_render_review": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "render_image": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "properties": {
        "render_direction": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "render_review": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "operation",
    "inputs",
    "outputs"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "create_direction"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "required": [
              "visual_brief",
              "scene_context",
              "style_context"
            ],
            "properties": {
              "visual_brief": {
                "type": "string",
                "minLength": 1
              },
              "scene_context": {
                "type": "string",
                "minLength": 1
              },
              "style_context": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outputs": {
            "required": [
              "render_direction"
            ],
            "properties": {
              "render_direction": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "review_render"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "required": [
              "visual_brief",
              "scene_context",
              "style_context",
              "previous_render_direction",
              "render_image"
            ],
            "properties": {
              "visual_brief": {
                "type": "string",
                "minLength": 1
              },
              "scene_context": {
                "type": "string",
                "minLength": 1
              },
              "style_context": {
                "type": "string",
                "minLength": 1
              },
              "previous_render_direction": {
                "type": "string",
                "minLength": 1
              },
              "render_image": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outputs": {
            "required": [
              "render_review"
            ],
            "properties": {
              "render_review": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "refine_direction"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "required": [
              "visual_brief",
              "scene_context",
              "style_context",
              "previous_render_direction",
              "previous_render_review"
            ],
            "properties": {
              "visual_brief": {
                "type": "string",
                "minLength": 1
              },
              "scene_context": {
                "type": "string",
                "minLength": 1
              },
              "style_context": {
                "type": "string",
                "minLength": 1
              },
              "previous_render_direction": {
                "type": "string",
                "minLength": 1
              },
              "previous_render_review": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outputs": {
            "required": [
              "render_direction"
            ],
            "properties": {
              "render_direction": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
