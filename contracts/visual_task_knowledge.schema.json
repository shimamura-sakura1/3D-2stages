{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "domain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "scene_type": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "content"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "domain",
    "scene_type"
  ],
  "additionalProperties": false
}
