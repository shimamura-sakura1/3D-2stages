{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeItem",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "kind",
    "domain",
    "topics",
    "applicability",
    "statement",
    "mechanism",
    "signals",
    "diagnosis",
    "interventions",
    "tradeoffs",
    "non_applicability",
    "evidence",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_.]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kind": {
      "enum": [
        "principle",
        "heuristic",
        "diagnostic",
        "procedure",
        "technical"
      ]
    },
    "domain": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "camera",
          "composition",
          "lighting",
          "atmosphere",
          "lookdev",
          "diagnostics",
          "renderer",
          "scene_type"
        ]
      }
    },
    "topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "applicability": {
      "type": "object",
      "required": [
        "tasks",
        "scene_types",
        "renderers"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "scene_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "renderers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "signals": {
      "type": "object",
      "required": [
        "positive",
        "negative"
      ],
      "properties": {
        "positive": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negative": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "diagnosis": {
      "type": "object",
      "required": [
        "inspect"
      ],
      "properties": {
        "inspect": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "interventions": {
      "type": "object",
      "required": [
        "consider"
      ],
      "properties": {
        "consider": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_applicability": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "confidence",
        "basis",
        "sources"
      ],
      "properties": {
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "draft",
        "canonical",
        "deprecated"
      ]
    }
  },
  "additionalProperties": false
}
