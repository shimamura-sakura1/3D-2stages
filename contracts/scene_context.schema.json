{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scene": {
      "type": "object",
      "properties": {
        "scene_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "primary_subject": {
          "type": "object",
          "properties": {
            "object_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            },
            "bounds": {
              "type": "object",
              "properties": {
                "center": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000.0,
                    "maximum": 1000000.0
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "size": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000.0
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "required": [
                "center",
                "size"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "object_id",
            "bounds"
          ],
          "additionalProperties": false
        },
        "bounds": {
          "type": "object",
          "properties": {
            "center": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000.0,
                "maximum": 1000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "size": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000.0
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "center",
            "size"
          ],
          "additionalProperties": false
        },
        "secondary_subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "object_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
              },
              "bounds": {
                "type": "object",
                "properties": {
                  "center": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": -1000000.0,
                      "maximum": 1000000.0
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "size": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1000000.0
                    },
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "required": [
                  "center",
                  "size"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "object_id",
              "bounds"
            ],
            "additionalProperties": false
          }
        },
        "environment_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "ground_z": {
          "type": "number",
          "minimum": -1000000.0,
          "maximum": 1000000.0
        }
      },
      "required": [
        "scene_type",
        "primary_subject",
        "bounds",
        "secondary_subjects",
        "environment_summary",
        "ground_z"
      ],
      "additionalProperties": false
    },
    "production": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "scene_version": {
          "type": "integer",
          "minimum": 1
        },
        "geometry_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scene_spec_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "style_assignment_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "material_map_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "look_revision": {
          "type": "integer",
          "minimum": 0
        },
        "render_revision": {
          "type": "integer",
          "minimum": 0
        },
        "blockout_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "project_id",
        "scene_version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "scene",
    "production"
  ],
  "additionalProperties": false
}
