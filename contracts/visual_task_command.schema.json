{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "command": {
      "enum": [
        "capabilities",
        "prepare",
        "start",
        "status",
        "submit",
        "interrupt",
        "collect"
      ]
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "spec": {
      "type": "object"
    },
    "decision": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "command"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "not": {
              "const": "capabilities"
            }
          }
        }
      },
      "then": {
        "required": [
          "project"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "enum": [
              "prepare",
              "start",
              "submit",
              "interrupt",
              "collect"
            ]
          }
        }
      },
      "then": {
        "required": [
          "expected_version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "prepare"
          }
        }
      },
      "then": {
        "required": [
          "spec"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "enum": [
              "start",
              "status",
              "submit",
              "interrupt",
              "collect"
            ]
          }
        }
      },
      "then": {
        "required": [
          "task_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "submit"
          }
        }
      },
      "then": {
        "required": [
          "decision"
        ]
      }
    }
  ]
}
