{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "project_id": {
      "$ref": "visual_common.schema.json#/$defs/id"
    },
    "scene_version": {
      "type": "integer",
      "minimum": 1
    },
    "pass_id": {
      "type": "string",
      "pattern": "^pass_[0-9]{2,}$"
    },
    "build_id": {
      "type": "string",
      "pattern": "^build_[0-9a-f]{16}$"
    },
    "inputs_digest": {
      "$ref": "visual_common.schema.json#/$defs/sha256"
    },
    "metadata_sha256": {
      "$ref": "visual_common.schema.json#/$defs/sha256"
    },
    "documents": {
      "type": "object",
      "additionalProperties": {
        "$ref": "visual_common.schema.json#/$defs/sha256"
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": {
        "$ref": "visual_common.schema.json#/$defs/sha256"
      }
    },
    "geometry_digest": {
      "$ref": "visual_common.schema.json#/$defs/sha256"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "namespace": {
            "enum": [
              "project",
              "repository"
            ]
          },
          "path": {
            "$ref": "visual_common.schema.json#/$defs/path"
          },
          "sha256": {
            "$ref": "visual_common.schema.json#/$defs/sha256"
          }
        },
        "required": [
          "namespace",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "setup": {
      "$ref": "visual_common.schema.json#/$defs/path"
    },
    "blockout": {
      "$ref": "visual_common.schema.json#/$defs/path"
    },
    "packet": {
      "$ref": "visual_common.schema.json#/$defs/path"
    },
    "repository_resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "visual_common.schema.json#/$defs/path"
          },
          "sha256": {
            "$ref": "visual_common.schema.json#/$defs/sha256"
          },
          "archive_path": {
            "$ref": "visual_common.schema.json#/$defs/path"
          }
        },
        "required": [
          "path",
          "sha256",
          "archive_path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "scene_version",
    "pass_id",
    "build_id",
    "inputs_digest",
    "metadata_sha256",
    "documents",
    "geometry",
    "geometry_digest",
    "files",
    "setup",
    "blockout",
    "packet"
  ],
  "additionalProperties": false
}
