{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "project_id": {
      "$ref": "visual_common.schema.json#/$defs/id"
    },
    "scene_version": {
      "type": "integer",
      "minimum": 1
    },
    "document_id": {
      "$ref": "visual_common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "mood": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "primary",
        "secondary"
      ],
      "additionalProperties": false
    },
    "visual_language": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "realism": {
          "enum": [
            "stylized",
            "semi_realistic",
            "realistic"
          ]
        },
        "character_compatibility": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "environment",
        "realism",
        "character_compatibility"
      ],
      "additionalProperties": false
    },
    "priorities": {
      "type": "array",
      "items": {
        "enum": [
          "atmosphere",
          "composition",
          "material_coherence",
          "geometry_detail",
          "lighting",
          "readability"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "constraints": {
      "type": "object",
      "properties": {
        "avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "avoid",
        "required"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "scene_version",
    "document_id",
    "revision",
    "mood",
    "visual_language",
    "priorities",
    "constraints"
  ],
  "additionalProperties": false
}
